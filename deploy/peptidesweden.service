[Unit]
Description=Peptidesweden webbplats (Node.js)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/peptidesweden
EnvironmentFile=/var/www/peptidesweden/.env
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning .output/server/index.mjs
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
