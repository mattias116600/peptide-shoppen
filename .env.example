# Kopiera till /var/www/peptidesweden/.env på servern
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
# Ordrar, rabattkoder och admin-konton (SQLite). Säkerhetskopiera den här filen.
DATABASE_PATH=/var/www/peptidesweden/data/peptidesweden.db

# Kryptobetalning via NOWPayments. Lämna tomt för att ta emot ordrar utan onlinebetalning.
# Hemliga nycklar: lägg dem bara i .env på servern, aldrig i git.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
# Sajtens publika adress; används för retur- och IPN-länkar.
PUBLIC_SITE_URL=https://peptidesweden.com
# Valfritt: https://api-sandbox.nowpayments.io/v1 för tester med ett sandbox-konto.
# NOWPAYMENTS_API_URL=https://api.nowpayments.io/v1
# Offentliga värden som behövs vid bygget måste börja med VITE_ (inga hemliga nycklar här)

# E-post till kunder (orderbekräftelse och leveransmejl) via valfri SMTP-tjänst.
# Lämna MAIL_FROM tomt för att inte skicka några mejl.
MAIL_FROM=Peptidesweden <order@peptidesweden.com>
# MAIL_REPLY_TO=support@peptidesweden.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# För test utan att skicka: MAIL_TRANSPORT=outbox sparar mejlen som .eml-filer i data/outbox.
